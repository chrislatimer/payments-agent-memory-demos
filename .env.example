# Copy to .env.local and fill in. Both keys are required.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.7-flash.
# GEMINI_MODEL=gemini-3.7-flash

# Hindsight: https://hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_...
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Optional. One bank per demo, created for you by the seed scripts.
# Override these if you are sharing a Hindsight account with someone else
# running the same demos, so your banks do not collide.
# HINDSIGHT_BANK_NAME=crestline-disputes-demo
# HINDSIGHT_WIRES_BANK=crestline-wires-demo
# HINDSIGHT_REWARDS_BANK=crestline-rewards-c-latimer
# HINDSIGHT_SAR_BANK=crestline-sar-audit
